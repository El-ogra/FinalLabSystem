<Window x:Class="FinalLabSystem.Views.Settings.SecuritySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinalLabSystem.ViewModels.Settings"
        d:DataContext="{d:DesignInstance Type=vm:SecuritySettingsWindowViewModel}"
        mc:Ignorable="d"
        Title="إعدادات الأمان"
        MinHeight="450" SizeToContent="WidthAndHeight" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إعدادات كلمات مرور الشاشات الحساسة"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="درج النقدية" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="كلمة المرور المستخدمة لفتح درج النقدية"
                               FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="CashDrawerStatus"
                           Text="{Binding CashDrawerPasswordSet, StringFormat='{}{0}'}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="#666"/>

                <Button Grid.Column="2" Content="تغيير كلمة المرور"
                        Command="{Binding ChangeCashDrawerPasswordCommand}"
                        Width="140" Height="30"
                        Background="#1976D2" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="صيانة قاعدة البيانات" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="كلمة المرور المطلوبة للنسخ الاحتياطي والاستعادة"
                               FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="#666">
                    <TextBlock.Text>
                        <Binding Path="DbMaintenancePasswordSet" StringFormat="{}{0}"/>
                    </TextBlock.Text>
                </TextBlock>

                <Button Grid.Column="2" Content="تغيير كلمة المرور"
                        Command="{Binding ChangeDbMaintenancePasswordCommand}"
                        Width="140" Height="30"
                        Background="#1976D2" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="إعدادات النظام" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="كلمة المرور للوصول إلى إعدادات النظام الحساسة"
                               FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="#666">
                    <TextBlock.Text>
                        <Binding Path="SettingsPasswordSet" StringFormat="{}{0}"/>
                    </TextBlock.Text>
                </TextBlock>

                <Button Grid.Column="2" Content="تغيير كلمة المرور"
                        Command="{Binding ChangeSettingsPasswordCommand}"
                        Width="140" Height="30"
                        Background="#1976D2" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText"
                   Text="{Binding StatusMessage}"
                   Foreground="#2E7D32" FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>

        <Button Grid.Row="5" Content="إغلاق"
                Click="Close_Click"
                Width="100" Height="35" Margin="0,12,0,0"
                Background="#E53935" Foreground="White" FontWeight="Bold"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
