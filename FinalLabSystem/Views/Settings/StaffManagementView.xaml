<UserControl x:Class="FinalLabSystem.Views.Settings.StaffManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="إدارة الموظفين - تحديد حد الخصم"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding StaffList}"
                     SelectedItem="{Binding SelectedStaff}"
                     DisplayMemberPath="DisplayName"
                     Margin="0,0,5,0"/>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          Background="Gray"
                          Margin="2,0"/>

            <Border Grid.Column="2"
                    BorderBrush="#0A252C"
                    BorderThickness="1"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="بيانات الموظف" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <Label Content="اسم المستخدم:"/>
                    <TextBox Text="{Binding SelectedStaff.Username, FallbackValue=''}" IsReadOnly="True" Margin="0,0,0,5"/>

                    <Label Content="الاسم المعروض:"/>
                    <TextBox Text="{Binding SelectedStaff.DisplayName, FallbackValue=''}" Margin="0,0,0,5"/>

                    <Label Content="الاسم بالعربية:"/>
                    <TextBox Text="{Binding SelectedStaff.DisplayNameAr, FallbackValue=''}" Margin="0,0,0,5"/>

                    <Label Content="المسمى الوظيفي:"/>
                    <TextBox Text="{Binding SelectedStaff.JobTitle, FallbackValue=''}" Margin="0,0,0,5"/>

                    <Label Content="هاتف:"/>
                    <TextBox Text="{Binding SelectedStaff.Phone, FallbackValue=''}" Margin="0,0,0,5"/>

                    <Label Content="بريد إلكتروني:"/>
                    <TextBox Text="{Binding SelectedStaff.Email, FallbackValue=''}" Margin="0,0,0,5"/>

                    <CheckBox Content="نشط"
                              IsChecked="{Binding SelectedStaff.IsActive}"
                              Margin="0,0,0,5"/>

                    <Label Content="حد الخصم المسموح (%)"/>
                    <TextBox Text="{Binding SelectedStaff.DiscountLimit, FallbackValue='0'}"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding SelectedDiscountLimitDisplay}"
                               FontStyle="Italic"
                               Foreground="Gray"
                               Margin="0,0,0,10"/>

                    <Button Content="حفظ التعديلات"
                            Command="{Binding SaveCommand}"
                            Height="30"
                            Background="#9CCC22"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
