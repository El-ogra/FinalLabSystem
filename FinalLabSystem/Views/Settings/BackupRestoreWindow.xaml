<Window x:Class="FinalLabSystem.Views.Settings.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="النسخ الاحتياطي والاستعادة (SQL Server)"
        Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <Style x:Key="BackupButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Background="#E3F2FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1565C0">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Button Content="نسخ كامل (Full)" Command="{Binding CreateFullBackupCommand}"
                        Style="{StaticResource BackupButtonStyle}"
                        Background="#1E88E5" Foreground="White"/>
                <Button Content="نسخ تفاضيلي (Differential)" Command="{Binding CreateDifferentialBackupCommand}"
                        Style="{StaticResource BackupButtonStyle}"
                        Background="#1565C0" Foreground="White"
                        ToolTip="نسخ احتياطي للبيانات المعدلة منذ آخر نسخة كاملة"/>
                <Separator Margin="8,0" Background="White"/>
                <Button Content="استعادة" Command="{Binding RestoreCommand}"
                        Style="{StaticResource BackupButtonStyle}"
                        Background="#E53935" Foreground="White"/>
                <Button Content="استعادة نسخة قديمة" Command="{Binding RestoreLegacyCommand}"
                        Style="{StaticResource BackupButtonStyle}"
                        Background="#C62828" Foreground="White"
                        ToolTip="استعادة نسخة احتياطية قديمة بتنسيق JSON مشفر (.bak.enc)"/>
                <Separator Margin="8,0" Background="White"/>
                <Button Content="تصفح المجلد" Command="{Binding BrowseFolderCommand}"
                        Style="{StaticResource BackupButtonStyle}"
                        Background="#FF8F00" Foreground="White"/>
                <Button Content="فتح المجلد" Command="{Binding OpenFolderCommand}"
                        Style="{StaticResource BackupButtonStyle}"
                        Background="#43A047" Foreground="White"/>
                <Separator Margin="8,0" Background="White"/>
                <TextBlock Text="{Binding Backups.Count, StringFormat='عدد النسخ: {0}'}"
                           Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>
        </Border>

        <!-- Backup Type Info -->
        <Border Grid.Row="1" Background="#E8F5E9" Padding="8,6" Margin="8,4,8,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="نوع النسخ:" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="نسخ كامل (SQL Server BACKUP)" Foreground="#2E7D32" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="#999" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Text="نسخ تفاضيلي (DIFFERENTIAL)" Foreground="#1565C0" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="#999" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Text="تنسيق: .bak (بدون تشفير)" Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Backups}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F5F5F5"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#CCC"
                  Margin="8">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="60"/>
                <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="الحجم" Binding="{Binding DisplaySize}" Width="100"/>
                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding DisplayCreatedAt}" Width="140"/>
                <DataGridTextColumn Header="التنسيق" Binding="{Binding DisplayFormat}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#BBDEFB" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="المجلد:" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TargetFolder}" Foreground="#333" Margin="0,0,16,0"/>
                    <TextBlock Text="آخر نسخة:" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding LastBackupAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                               Foreground="#333"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SQL Server BACKUP الأصلي"
                           Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
