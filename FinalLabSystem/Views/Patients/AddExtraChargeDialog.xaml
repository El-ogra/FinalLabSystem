<Window x:Class="FinalLabSystem.Views.Patients.AddExtraChargeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة خدمة إضافية"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="Margin" Value="0,5,0,2"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="4,2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="4,2"/>
            </Style>
        </Grid.Resources>

        <StackPanel>
            <TextBlock Text="إضافة خدمة إضافية للزيارة"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <Label Content="نوع الخدمة:"/>
            <ComboBox ItemsSource="{Binding ChargeTypes}"
                      SelectedValue="{Binding SelectedChargeType}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Key"/>

            <Label Content="وصف الخدمة:"/>
            <TextBox Text="{Binding ChargeDescription, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsDescriptionReadOnly}"/>

            <Label Content="المبلغ:"/>
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="إضافة"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Width="90"
                        Height="32"
                        Margin="0,0,5,0"
                        Background="#9CCC22"
                        Foreground="White"
                        FontWeight="Bold"/>

                <Button Grid.Column="2"
                        Content="إلغاء"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Width="90"
                        Height="32"
                        Background="#CC3333"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
