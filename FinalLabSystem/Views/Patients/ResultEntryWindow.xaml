<Window x:Class="FinalLabSystem.Views.Patients.ResultEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FinalLabSystem.Views"
        Title="إدخال نتيجة التحليل" MinHeight="520" SizeToContent="WidthAndHeight" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#1E2A3A">
    <Window.Resources>
        <converters:ClinicalStatusToBrushConverter x:Key="ClinicalStatusToBrush"/>
        <converters:BoolToLockedBrushConverter x:Key="BoolToLockedBrush"/>
        <converters:BoolToLockedTipConverter x:Key="BoolToLockedTip"/>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding TestTypeName}" FontWeight="Bold" FontSize="16"
                       Foreground="#FFFFFF" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- Comment section (Slice 4.1) -->
        <Border DockPanel.Dock="Bottom" Background="#2A3F54" Padding="8" Margin="0,8,0,0"
                CornerRadius="4" BorderBrush="#555" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Comment:" Foreground="#AAAAAA" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تعليم" Background="#F58220" Foreground="White"
                                Command="{Binding OpenCommentPickerCommand}"
                                Width="60" Height="22" FontSize="11" Margin="0,0,6,0"
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="تراجع" Background="#78909C" Foreground="White"
                                Command="{Binding UndoLastCommentCommand}"
                                Width="60" Height="22" FontSize="11"
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBox Text="{Binding SelectedComponent.Comment, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1E2A3A" Foreground="#FFFFFF"
                             BorderBrush="#555" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Padding="4"/>
                    <!-- Comment Templates Popup (Slice 4.1) -->
                    <Popup IsOpen="{Binding IsCommentPickerOpen}" PlacementTarget="{Binding ElementName=CommentTextBox}"
                           Placement="Top" StaysOpen="False" MaxHeight="200" Width="350">
                        <Border Background="#2A3F54" BorderBrush="#555" BorderThickness="1"
                                CornerRadius="4" Padding="4">
                            <ListBox ItemsSource="{Binding CommentTemplates}"
                                     Background="#2A3F54" Foreground="#FFFFFF"
                                     BorderThickness="0"
                                     SelectedValuePath="CommentText">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,2" Margin="0,1" Cursor="Hand"
                                                Background="Transparent" CornerRadius="3">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.PickCommentTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding CommentText}" FontSize="11"
                                                           Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Action buttons (Slice 4.3) -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="حفظ و مراجعة" Command="{Binding SaveAndReviewCommand}" Width="110" Height="32"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                    Margin="0,0,8,0"/>
            <Button Content="حفظ" Command="{Binding SaveCommand}" Width="80" Height="32"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Margin="0,0,8,0"/>
            <Button Content="طباعة" Command="{Binding PrintCommand}" Width="80" Height="32"
                    Background="#FF9800" Foreground="White" FontWeight="Bold"
                    Margin="0,0,8,0"/>
            <Button Content="معاينة" Command="{Binding PreviewPrintCommand}" Width="80" Height="32"
                    Background="#42A5F5" Foreground="White" FontWeight="Bold"
                    Margin="0,0,8,0"/>
            <Button Content="تاريخ مرضي" Command="{Binding OpenMedicalHistoryCommand}" Width="90" Height="32"
                    Background="#7E57C2" Foreground="White" FontWeight="Bold"
                    Margin="0,0,8,0"/>
            <Button Content="العودة" Command="{Binding ReturnToMainCommand}" Width="80" Height="32"
                    Background="#78909C" Foreground="White" FontWeight="Bold"
                    Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding CancelCommand}" Width="80" Height="32"
                    Background="#F44336" Foreground="White" FontWeight="Bold"
                    IsCancel="True"/>
        </StackPanel>

        <!-- DataGrid (Slice 4.2: read-only highlight for locked results) -->
        <DataGrid ItemsSource="{Binding Components}" AutoGenerateColumns="False"
                  IsReadOnly="False" CanUserAddRows="False"
                  SelectedItem="{Binding SelectedComponent}"
                  Background="#2A3F54" Foreground="#FFFFFF"
                  RowBackground="#2A3F54" AlternatingRowBackground="#1E2A3A"
                  BorderBrush="#3A5068" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="حفظ" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelectedForSave, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="الكود" Binding="{Binding ComponentCode}"
                                    IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="المكوّن" Binding="{Binding ComponentName}"
                                    IsReadOnly="True" Width="*"/>
                <DataGridTemplateColumn Header="النتيجة" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ResultValue, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsResultLocked}"
                                     Background="{Binding IsResultLocked, Converter={StaticResource BoolToLockedBrush}}"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#555" BorderThickness="1" Padding="4,2"
                                     ToolTip="{Binding IsResultLocked, Converter={StaticResource BoolToLockedTip}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding SnapUnit}"
                                    IsReadOnly="True" Width="60"/>
                <DataGridTemplateColumn Header="L/H" Width="45" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LOrH}" FontWeight="Bold"
                                       HorizontalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LOrH}" Value="H">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LOrH}" Value="L">
                                                <Setter Property="Foreground" Value="#2196F3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LOrH}" Value="HH">
                                                <Setter Property="Foreground" Value="#FF0000"/>
                                                <Setter Property="Text" Value="!!H"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LOrH}" Value="LL">
                                                <Setter Property="Foreground" Value="#0000FF"/>
                                                <Setter Property="Text" Value="!!L"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="المدى" Binding="{Binding SnapNormalText}"
                                    IsReadOnly="True" Width="100"/>
                <DataGridTemplateColumn Header="الحالة" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding ClinicalStatus, Converter={StaticResource ClinicalStatusToBrush}}"
                                    CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ClinicalStatus}" FontWeight="Bold"
                                           Foreground="White" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Verified" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsVerified}"
                                      IsEnabled="False" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Print" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsPrintEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Phase 7 placeholder: custom result editors will be hosted here -->
        <ContentPresenter Content="{Binding CustomEditorContent}"
                          Margin="0,8,0,0"
                          Visibility="Collapsed"/>
    </DockPanel>

    <!-- Slice 4.4: Keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="F8" Command="{Binding SaveAndReviewCommand}"/>
        <KeyBinding Key="F11" Command="{Binding PreviewPrintCommand}"/>
        <KeyBinding Key="F12" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
</Window>
