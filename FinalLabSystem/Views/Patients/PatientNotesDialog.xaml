<Window x:Class="FinalLabSystem.Views.Patients.PatientNotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ملاحظات المريض"
        Width="500" Height="350"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#0D2137"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ملاحظات المريض" FontWeight="Bold" FontSize="16"
                   Foreground="#FFFFFF" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="180"
                 Background="#FFFFFF" Foreground="#333333"
                 BorderBrush="#3A5068" BorderThickness="1"
                 FontSize="13" Padding="6"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="حفظ" Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Width="80" Height="30" Margin="6,0"
                    Background="#4CAF50" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
            <Button Content="إلغاء" Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Width="80" Height="30" Margin="6,0"
                    Background="#F44336" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>