<Window x:Class="FinalLabSystem.Views.Patients.BarcodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:barcoding="clr-namespace:FinalLabSystem.Infrastructure.Barcoding"
        Title="طباعة الباركود" MinHeight="700" SizeToContent="WidthAndHeight" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <barcoding:BarcodeImageConverter x:Key="BarcodeImageConverter"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- Bottom: Print All + Checkbox + Offsets -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="إزاحة أفقي:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Width="120" Minimum="-20" Maximum="20" TickFrequency="0.5"
                        Value="{Binding PreviewOffsetX}" VerticalAlignment="Center"/>
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="إزاحة رأسي:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Width="120" Minimum="-20" Maximum="20" TickFrequency="0.5"
                        Orientation="Vertical" Height="60"
                        Value="{Binding PreviewOffsetY}" VerticalAlignment="Center"/>
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <Button Content="حفظ الأبعاد" Command="{Binding SavePrintOffsetsCommand}"
                        Padding="10,4" Margin="8,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="طباعة الكل"
                        Command="{Binding PrintAllCommand}"
                        Height="36" MinWidth="160"
                        Background="#F58220" Foreground="White" FontWeight="Bold"/>
                <CheckBox Content="طباعة كود المعمل مع الكل"
                          IsChecked="{Binding IncludeLabIdInPrintAll}"
                          Margin="12,0,0,0" VerticalAlignment="Center"
                          FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <!-- Main scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Section 1: Tube Labels -->
                <TextBlock Text="ملصقات الأنابيب" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"
                           Background="#A8E000" Foreground="#001A20" Padding="6,2"/>
                <ItemsControl ItemsSource="{Binding Labels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                    Width="300" Padding="8" AllowDrop="True"
                                    Drop="Border_Drop" Tag="{Binding}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.PrintBarcodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.DraggedLabel, RelativeSource={RelativeSource AncestorType=Window}}" Value="{Binding}">
                                                <Setter Property="Background" Value="#E0F0FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding PatientNameAr}"
                                               FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding SexAgeLine}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TestCodesLine}"
                                               FontSize="11" Margin="0,2,0,0"
                                               Cursor="Hand" ToolTip="اسحب للنقل بين الملصقات"/>
                                    <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                           Margin="0,4" HorizontalAlignment="Center"
                                           Stretch="None"/>
                                    <TextBlock FontSize="10" Margin="0,2,0,0">
                                        <Run Text="{Binding PatientIdentifierLine}"/>
                                        <Run Text="   "/>
                                        <Run Text="{Binding TubeName}"/>
                                    </TextBlock>
                                    <Button Content="حذف التحاليل"
                                            Command="{Binding DataContext.RemoveTestFromLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Center"
                                            FontSize="10" Padding="6,2"
                                            Foreground="Red" Background="Transparent"
                                            BorderThickness="0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Section 2: Case + File -->
                <TextBlock Text="كود الحالة (Case)" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"
                           Background="#A8E000" Foreground="#001A20" Padding="6,2"/>
                <ItemsControl ItemsSource="{Binding CaseLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                    Width="300" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding PatientNameAr}"
                                               FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding SexAgeLine}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TypeName}"
                                               FontSize="11" Margin="0,2,0,0" FontWeight="Bold"/>
                                    <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                           Margin="0,4" HorizontalAlignment="Center"
                                           Stretch="None"/>
                                    <TextBlock FontSize="10" Margin="0,2,0,0">
                                        <Run Text="{Binding PatientIdentifierLine}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="كود الملف (File)" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"
                           Background="#A8E000" Foreground="#001A20" Padding="6,2"/>
                <ItemsControl ItemsSource="{Binding FileLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                    Width="300" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding PatientNameAr}"
                                               FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding SexAgeLine}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TypeName}"
                                               FontSize="11" Margin="0,2,0,0" FontWeight="Bold"/>
                                    <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                           Margin="0,4" HorizontalAlignment="Center"
                                           Stretch="None"/>
                                    <TextBlock FontSize="10" Margin="0,2,0,0">
                                        <Run Text="{Binding PatientIdentifierLine}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Section 3: Lab ID -->
                <TextBlock Text="كود المعمل الدائم (Lab ID)" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"
                           Background="#A8E000" Foreground="#001A20" Padding="6,2"/>
                <ItemsControl ItemsSource="{Binding LabIdLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                    Width="300" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding PatientNameAr}"
                                               FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding SexAgeLine}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TypeName}"
                                               FontSize="11" Margin="0,2,0,0" FontWeight="Bold"/>
                                    <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                           Margin="0,4" HorizontalAlignment="Center"
                                           Stretch="None"/>
                                    <TextBlock FontSize="10" Margin="0,2,0,0">
                                        <Run Text="{Binding PatientIdentifierLine}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Section 4: Extra Barcode -->
                <TextBlock Text="باركود إضافي" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"
                           Background="#A8E000" Foreground="#001A20" Padding="6,2"/>
                <StackPanel Margin="6,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="180" Height="28" Margin="0,0,6,0"
                                 Text="{Binding NewExtraHeader, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        <TextBox Width="220" Height="28" Margin="0,0,6,0"
                                 Text="{Binding NewExtraDescription, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="+ إضافة" Command="{Binding AddExtraLabelCommand}"
                                Width="70" Height="28"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ExtraLabels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                        Width="300" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                        <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                               Margin="0,4" HorizontalAlignment="Center"
                                               Stretch="None"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="طباعة"
                                                    Command="{Binding DataContext.PrintExtraLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2" Margin="0,0,6,0"/>
                                            <Button Content="حذف"
                                                    Command="{Binding DataContext.RemoveExtraLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2" Foreground="Red"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
