<Window x:Class="FinalLabSystem.Views.Patients.BarcodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:barcoding="clr-namespace:FinalLabSystem.Infrastructure.Barcoding"
        Title="طباعة الباركود" Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <barcoding:BarcodeImageConverter x:Key="BarcodeImageConverter"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Content="طباعة الكل"
                Command="{Binding PrintAllCommand}"
                Height="36" Margin="0,10,0,0"/>
        <TabControl>
            <!-- القسم 1: ملصقات الأنابيب -->
            <TabItem Header="ملصقات الأنابيب">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Labels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                        Width="300" Padding="8">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.PrintBarcodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PatientNameAr}"
                                                   FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding SexAgeLine}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding TestCodesLine}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                        <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                               Margin="0,4" HorizontalAlignment="Center"
                                               Stretch="None"/>
                                        <TextBlock FontSize="10" Margin="0,2,0,0">
                                            <Run Text="{Binding PatientIdentifierLine}"/>
                                            <Run Text="   "/>
                                            <Run Text="{Binding TubeName}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- القسم 2: كود الحالة + كود الملف -->
            <TabItem Header="كود الحالة + كود الملف">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="كود الحالة (Case)" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding CaseLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                            Width="300" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PatientNameAr}"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding SexAgeLine}"
                                                       FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TypeName}"
                                                       FontSize="11" Margin="0,2,0,0" FontWeight="Bold"/>
                                            <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                                   Margin="0,4" HorizontalAlignment="Center"
                                                   Stretch="None"/>
                                            <TextBlock FontSize="10" Margin="0,2,0,0">
                                                <Run Text="{Binding PatientIdentifierLine}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="كود الملف (File)" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                        <ItemsControl ItemsSource="{Binding FileLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                            Width="300" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PatientNameAr}"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding SexAgeLine}"
                                                       FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TypeName}"
                                                       FontSize="11" Margin="0,2,0,0" FontWeight="Bold"/>
                                            <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                                   Margin="0,4" HorizontalAlignment="Center"
                                                   Stretch="None"/>
                                            <TextBlock FontSize="10" Margin="0,2,0,0">
                                                <Run Text="{Binding PatientIdentifierLine}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="طباعة كود الحالة والملف"
                                Command="{Binding PrintCaseLabelsCommand}"
                                Height="36" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- القسم 3: كود المعمل -->
            <TabItem Header="كود المعمل (Lab ID)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="كود المعمل الدائم (Lab ID)" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding LabIdLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333" BorderThickness="1" Margin="6"
                                            Width="300" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PatientNameAr}"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding SexAgeLine}"
                                                       FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TypeName}"
                                                       FontSize="11" Margin="0,2,0,0" FontWeight="Bold"/>
                                            <Image Source="{Binding BarcodePayload, Converter={StaticResource BarcodeImageConverter}}"
                                                   Margin="0,4" HorizontalAlignment="Center"
                                                   Stretch="None"/>
                                            <TextBlock FontSize="10" Margin="0,2,0,0">
                                                <Run Text="{Binding PatientIdentifierLine}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="طباعة كود المعمل"
                                Command="{Binding PrintLabIdCommand}"
                                Height="36" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
